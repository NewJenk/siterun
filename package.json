{
	"name": "siterun",
	"productName": "siterun",
	"version": "0.1.0",
	"private": true,
	"license": "GPL-3.0-or-later",
	"description": "The simplest way to run WordPress locally.",
	"author": "GOING BOLD LTD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NewJenk/siterun.git"
	},
	"homepage": "https://github.com/NewJenk/siterun",
	"bugs": {
		"url": "https://github.com/NewJenk/siterun/issues"
	},
	"main": "dist/main/index.js",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"build:prod": "node scripts/build.mjs --production",
		"start": "npm run engine:build && npm run build && node scripts/prepare-dev-app.mjs && electron .",
		"dev": "npm run engine:build && node scripts/prepare-dev-app.mjs && node scripts/dev.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p engine/tsconfig.json --noEmit",
		"lint": "eslint . && stylelint \"src/renderer/**/*.css\"",
		"lint:fix": "eslint . --fix && stylelint \"src/renderer/**/*.css\" --fix",
		"test": "node --experimental-strip-types --test tests/*.test.ts",
		"e2e": "npm run engine:build && npm run build && playwright test",
		"package": "npm run engine:bundle && npm run build:prod && electron-builder --dir",
		"make": "npm run engine:bundle && npm run build:prod && electron-builder",
		"engine:build": "vite build --config engine/vite.config.mjs",
		"engine:watch": "vite build --config engine/vite.config.mjs --watch",
		"engine:bundle": "npm run engine:build && node scripts/engine-bundle.mjs",
		"make:mac": "npm run engine:bundle && npm run build:prod && dotenv -e .secrets/signing.env -- electron-builder --mac --arm64 && dotenv -e .secrets/signing.env -- node scripts/notarize-dmg.mjs"
	},
	"devDependencies": {
		"@automattic/generate-password": "^0.2.0",
		"@formatjs/intl-localematcher": "^0.5.4",
		"@inquirer/ansi": "^1.0.2",
		"@inquirer/core": "^10.3.2",
		"@inquirer/figures": "^1.0.15",
		"@inquirer/prompts": "^8.5.2",
		"@playwright/test": "^1.65.1",
		"@types/archiver": "^8.0.0",
		"@types/http-proxy": "^1.17.17",
		"@types/lockfile": "^1.0.4",
		"@types/node": "^24.10.1",
		"@types/node-forge": "^1.3.14",
		"@types/react": "^18.3.27",
		"@types/react-dom": "^18.3.7",
		"@types/semver": "^7.7.1",
		"@types/shell-quote": "^1.7.5",
		"@types/yargs": "^17.0.35",
		"@types/yauzl": "^2.10.3",
		"@vscode/sudo-prompt": "^9.3.2",
		"@wordpress/admin-ui": "^2.11.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/dataviews": "^19.1.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/eslint-plugin": "^25.7.0",
		"@wordpress/hooks": "^4.56.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/icons": "^17.0.0",
		"@wordpress/theme": "^2.2.0",
		"@wordpress/ui": "^0.23.0",
		"@wp-playground/blueprints": "3.1.53",
		"archiver": "^8.0.0",
		"atomically": "^2.1.1",
		"chalk": "^5.6.2",
		"chokidar": "^5.0.0",
		"cli-table3": "^0.6.5",
		"date-fns": "^4.1.0",
		"dotenv-cli": "^8.0.0",
		"electron": "43.6.0",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"fs-extra": "^11.3.4",
		"glob": "^14.0.2",
		"globals": "^17.8.0",
		"http-proxy": "^1.18.1",
		"ignore": "^7.0.5",
		"lockfile": "^1.0.4",
		"node-forge": "^1.4.3",
		"picospinner": "^3.0.0",
		"postal-mime": "^4.1.4",
		"semver": "^7.7.4",
		"shell-quote": "^1.10.0",
		"stylelint": "^17.16.0",
		"tar": "^7.5.21",
		"trash": "^10.0.1",
		"typescript": "~5.9.3",
		"undici": "^8.6.0",
		"vite": "^8.3.5",
		"yargs": "^18.2.0",
		"yargs-parser": "^22.0.0",
		"yauzl": "^3.3.0",
		"zod": "^4.3.6"
	},
	"build": {
		"appId": "app.siterun.desktop",
		"productName": "siterun",
		"artifactName": "siterun-${version}-${os}-${arch}.${ext}",
		"directories": {
			"buildResources": "build",
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"build/icon.png",
			"package.json"
		],
		"extraResources": [
			{
				"from": "vendor/cli",
				"to": "cli",
				"filter": [
					"**/*"
				]
			},
			{
				"from": "LICENSE.md",
				"to": "LICENSE.md"
			},
			{
				"from": "THIRD-PARTY-NOTICES.md",
				"to": "THIRD-PARTY-NOTICES.md"
			}
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"target": [
				"dmg",
				"zip"
			],
			"icon": "build/icon.icns",
			"hardenedRuntime": true,
			"gatekeeperAssess": false,
			"entitlements": "build/entitlements.mac.plist",
			"entitlementsInherit": "build/entitlements.mac.plist",
			"binaries": [
				"Contents/Resources/cli/php-bin/8.4.27-studio-2/php",
				"Contents/Resources/cli/php-bin/8.4.27-studio-2/ext/xdebug.so"
			]
		},
		"win": {
			"target": [
				"nsis"
			],
			"icon": "build/icon.png"
		},
		"linux": {
			"category": "Development",
			"target": [
				"AppImage",
				"deb"
			],
			"icon": "build/icon.png"
		}
	}
}
