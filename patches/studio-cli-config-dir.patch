--- a/packages/common/lib/well-known-paths.ts
+++ b/packages/common/lib/well-known-paths.ts
@@ -2,6 +2,11 @@
 import path from 'path';
 
 export function getConfigDirectory(): string {
+	// A host app can own the engine's data instead of sharing ~/.studio with a
+	// separately installed Studio. The host sets this for every CLI child.
+	if ( process.env.STUDIO_CONFIG_DIR ) {
+		return process.env.STUDIO_CONFIG_DIR;
+	}
 	if ( process.env.DEV_CONFIG_DIR ) {
 		return process.env.DEV_CONFIG_DIR;
