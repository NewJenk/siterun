+// Existing directory with an index.html: serve the static page the way a
+// normal web server does. Static site generators and their previews put
+// their entry point here, and WordPress has no route for it, so falling
+// through to index.php would answer 404.
+if ( is_dir( $file ) ) {
+	$directory  = realpath( $file );
+	$index_file = $directory ? realpath( $directory . DIRECTORY_SEPARATOR . 'index.html' ) : false;
+
+	if (
+		$directory
+		&& false !== $index_file
+		&& is_file( $index_file )
+		&& str_starts_with( $index_file, $root . DIRECTORY_SEPARATOR )
+	) {
+		if ( ! str_ends_with( $path, '/' ) ) {
+			header( 'Location: ' . $path . '/', true, 301 );
+			return true;
+		}
+
+		header( 'Content-Type: text/html; charset=utf-8' );
+		header( 'Content-Length: ' . filesize( $index_file ) );
+		readfile( $index_file );
+		return true;
+	}
+}
+
